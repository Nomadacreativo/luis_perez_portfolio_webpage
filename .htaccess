# ==============================================================================
# HOSTINGER APACHE CONFIGURATION - LUISPEREZ.PRO
# Optimización de Rendimiento, Seguridad Reforzada, Caché y SSL
# ==============================================================================

# 1. SEGURIDAD DE DIRECTORIOS Y ARCHIVOS SENSIBLES
# Desactivar listado de directorios
Options -Indexes

# Bloquear acceso a archivos ocultos y de configuración (.git, .env, .htaccess, etc.)
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Bloquear archivos de respaldo o logs
<FilesMatch "\.(bak|config|sql|ini|log|sh|md)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# 2. FORZAR HTTPS Y REDIRECCIÓN LIMPIA
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Forzar HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Forzar dominio sin www (canónico: luisperez.pro)
  RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # URLs limpias sin .html
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.*)$ $1.html [NC,L]
</IfModule>

# 3. COMPRESIÓN GZIP / DEFLATE
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
  AddOutputFilterByType DEFLATE application/xml application/xhtml+xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml font/otf font/ttf font/woff font/woff2
</IfModule>

# 4. POLÍTICAS DE CACHÉ DEL NAVEGADOR (BROWSER CACHING)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # Imágenes
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Fuentes
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"

  # CSS y JavaScript
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"

  # HTML
  ExpiresByType text/html "access plus 1 hour"
</IfModule>

# 5. CABECERAS DE SEGURIDAD (SECURITY HEADERS)
<IfModule mod_headers.c>
  # Prevenir ataque MIME Sniffing
  Header set X-Content-Type-Options "nosniff"

  # Prevenir Clickjacking
  Header set X-Frame-Options "SAMEORIGIN"

  # Protección XSS para navegadores legados
  Header set X-XSS-Protection "1; mode=block"

  # Política de Referrer para evitar fuga de URLs
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # HSTS (Strict-Transport-Security) para forzar HTTPS
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # Deshabilitar APIs innecesarias en el navegador
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

  # Content Security Policy (CSP)
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self'; frame-ancestors 'self';"

  # Remover cabeceras de fingerprinting de servidor
  Header unset Server
  Header unset X-Powered-By
</IfModule>

# 6. PÁGINAS DE ERROR PERSONALIZADAS
ErrorDocument 404 /index.html

